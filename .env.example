# n8n
N8N_HOST=n8n.example.com
N8N_PROTOCOL=https
WEBHOOK_URL=https://n8n.example.com/
N8N_ENCRYPTION_KEY=                  # openssl rand -hex 32
GENERIC_TIMEZONE=Europe/Helsinki
N8N_BLOCK_ENV_ACCESS_IN_NODE=false   # workflows read config via $env
N8N_RESTRICT_FILE_ACCESS_TO=/data/knowledge;/data/prompts
NODE_FUNCTION_ALLOW_BUILTIN=crypto   # Code node needs crypto for the HMAC check

# Meta / Instagram
IG_GRAPH_BASE=https://graph.instagram.com
IG_GRAPH_VERSION=v26.0               # checked against Meta docs 2026-10-19; re-VERIFY
IG_ACCOUNT_ID=                       # user_id from GET /me?fields=user_id,username
IG_APP_SECRET=                       # signs webhooks, see plan 6.1 step 1
IG_APP_SECRET_ALT=                   # Phase 3 only: the other candidate secret; log shows which matches. Empty afterwards.
IG_VERIFY_TOKEN=                     # random string, also typed into the Meta dashboard

# LLM
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
ANTHROPIC_API_BASE=                  # optional, only for tests against a mock server

# Admin dashboard (https://n8n.<domain>/webhook/admin?key=<ADMIN_KEY>)
ADMIN_KEY=                           # 12+ random characters: openssl rand -hex 16

# Behaviour
BOT_MODE=shadow                      # starting mode only; the dashboard switch overrides it (off | shadow | auto)
OWNER_PAUSE_HOURS=12
DEBOUNCE_SECONDS=6
HISTORY_TURNS=10
RETENTION_DAYS=30

# Alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE=                   # optional, only for tests against a mock server
